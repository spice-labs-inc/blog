---
import { Image } from "astro:assets";
import logo from "@/assets/logo.png";
import site from "@/content/site.json";
const showCta = Astro.url.pathname !== "/get-started/";
---

<header id="header">
  <div id="logo">
    <a href="/">
      <h1><Image src={logo} alt="Spice Labs" width="223" height="48" /></h1>
    </a>
    <div class="divider"></div>
    <div class="title">Blog</div>
  </div>
  <div class="toolbar">
    {
      showCta && (
        <a class="button" href={site.cta.url}>
          {site.cta.label}
        </a>
      )
    }
  </div>
</header>

<style>
  .divider {
    width: 1px;
    height: 32px;
    background-color: rgba(255, 255, 255, 0.3);
    margin: 0 32px;
  }

  .title {
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-primary);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: relative;
    padding: 4px 0;
  }

  /* Fallback for browsers that don't support background-clip */
  @supports not (background-clip: text) {
    .title {
      color: var(--color-primary);
      -webkit-text-fill-color: var(--color-primary);
    }
  }
  #header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-height);
    color: var(--color-light);
    background-color: var(--color-black);
    padding: 0 24px;

    h1 {
      margin: 0;
    }
  }

  .toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .button.login {
    background: transparent;
    color: var(--color-light);
  }

  #logo {
    display: flex;
    align-items: center;
    padding-right: 24px;
  }

  @media (max-width: 768px) {
    #header {
      position: static;
      flex-direction: column;
      align-items: center;
      padding: 16px 20px 12px 60px;
      gap: 12px;
      min-height: auto;
    }

    #logo {
      padding-right: 0;
      flex-direction: row;
      gap: 12px;
      margin-left: 0;
      align-items: center;
      margin-top: 0;
      width: 100%;
      justify-content: center;
    }

    #logo h1 img {
      max-width: 200px;
      height: auto;
    }

    .divider {
      display: none;
    }

    .title {
      display: none;
    }

    .toolbar {
      flex-shrink: 0;
      gap: 8px;
      width: 100%;
      justify-content: center;
    }

    .button {
      padding: 6px 12px;
      font-size: 0.8125rem;
      min-height: auto;
    }
  }
</style>
