---

---

<div id="search-container">
  <div id="search-ui">
    <div class="search-placeholder">
      <input
        type="text"
        placeholder="Search..."
        disabled
        style="
        width: 100%;
        padding: 8px 40px 8px 40px;
        border: 1px solid var(--color-white-20);
        border-radius: 6px;
        background: var(--color-white-8);
        color: var(--color-light);
        font-size: 0.875rem;
        font-family: var(--font-ui);
        height: 36px;
        box-sizing: border-box;
      "
      />
    </div>
  </div>
</div>

<script is:inline>
  let pagefindLoaded = false;

  async function loadPagefind() {
    if (pagefindLoaded) return;

    try {
      const response = await fetch("/pagefind/pagefind.js");
      if (!response.ok) throw new Error("Pagefind not available");

      const cssLink = document.createElement("link");
      cssLink.rel = "stylesheet";
      cssLink.href = "/pagefind/pagefind-ui.css";
      document.head.appendChild(cssLink);

      const script = document.createElement("script");
      script.src = "/pagefind/pagefind.js";
      document.head.appendChild(script);

      const uiScript = document.createElement("script");
      uiScript.src = "/pagefind/pagefind-ui.js";
      document.head.appendChild(uiScript);

      await new Promise((resolve, reject) => {
        uiScript.onload = resolve;
        uiScript.onerror = reject;
      });

      // Remove placeholder before initializing Pagefind
      const placeholder = document.querySelector(".search-placeholder");
      if (placeholder) placeholder.remove();

      new window.PagefindUI({
        element: "#search-ui",
        showSubResults: false,
        showImages: false,
        excerptLength: 10,
        resetStyles: true,
        bundlePath: "/pagefind/",
        showEmptyFilters: false,
        autofocus: false
      });

      pagefindLoaded = true;
    } catch (error) {
      // In dev mode, show a non-functional but styled search interface
      const searchUI = document.getElementById("search-ui");
      if (searchUI) {
        // Remove placeholder
        const placeholder = document.querySelector(".search-placeholder");
        if (placeholder) placeholder.remove();

        // Create dev mode search interface
        searchUI.innerHTML = `
          <div class="pagefind-ui">
            <form class="pagefind-ui__form">
              <input class="pagefind-ui__search-input" type="search" placeholder="Search in prod builds" disabled>
              <button type="button" class="pagefind-ui__search-clear" disabled style="display: none;">Clear</button>
            </form>
            <div class="pagefind-ui__results-area"></div>
          </div>
        `;
      }
    }
  }

  function initSearch() {
    loadPagefind();

    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        const searchInput = document.querySelector("#search-ui input");
        if (searchInput) searchInput.focus();
      }
    });

    setTimeout(fixSearchUX, 1000);
  }

  function fixSearchUX() {
    const searchInput = document.querySelector("#search-ui input");
    let selectedIndex = -1;
    let results = [];

    const waitForElements = () => {
      const form = document.querySelector("#search-ui .pagefind-ui__form");
      if (!form || !searchInput) {
        setTimeout(waitForElements, 100);
        return;
      }

      const toggleIcon = () => {
        const hasValue = searchInput.value.trim().length > 0;
        const isFocused = document.activeElement === searchInput;

        if (hasValue || isFocused) {
          form.classList.add("hide-search-icon");
        } else {
          form.classList.remove("hide-search-icon");
        }
      };

      searchInput.addEventListener("input", toggleIcon);
      searchInput.addEventListener("focus", toggleIcon);
      searchInput.addEventListener("blur", toggleIcon);
      toggleIcon();
    };

    const updateSelectedResult = () => {
      results = Array.from(document.querySelectorAll("#search-ui .pagefind-ui__result"));
      results.forEach((result, index) => {
        if (index === selectedIndex) {
          result.classList.add("selected");
          result.scrollIntoView({ block: "nearest", behavior: "smooth" });
        } else {
          result.classList.remove("selected");
        }
      });
    };

    waitForElements();

    if (searchInput) {
      searchInput.addEventListener("keydown", (e) => {
        results = Array.from(document.querySelectorAll("#search-ui .pagefind-ui__result"));

        if (e.key === "ArrowDown") {
          e.preventDefault();
          selectedIndex = Math.min(selectedIndex + 1, results.length - 1);
          updateSelectedResult();
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          selectedIndex = Math.max(selectedIndex - 1, -1);
          updateSelectedResult();
        } else if (e.key === "Tab" && results.length > 0) {
          e.preventDefault();
          selectedIndex = e.shiftKey
            ? Math.max(selectedIndex - 1, -1)
            : Math.min(selectedIndex + 1, results.length - 1);
          updateSelectedResult();
        } else if (e.key === "Enter" && selectedIndex >= 0 && results[selectedIndex]) {
          e.preventDefault();
          const link = results[selectedIndex].querySelector(".pagefind-ui__result-link");
          if (link) {
            searchInput.value = "";
            searchInput.dispatchEvent(new Event("input"));
            window.location.href = link.href;
          }
        } else if (e.key === "Escape") {
          selectedIndex = -1;
          updateSelectedResult();
          searchInput.blur();
        }
      });
    }

    document.addEventListener("click", (e) => {
      const result = e.target.closest("#search-ui .pagefind-ui__result");
      if (result) {
        const link = result.querySelector(".pagefind-ui__result-link");
        if (link) {
          e.preventDefault();
          e.stopPropagation();
          if (searchInput) {
            searchInput.value = "";
            searchInput.dispatchEvent(new Event("input"));
          }
          window.location.href = link.href;
        }
      }
    });

    const observer = new MutationObserver(() => {
      const results = document.querySelectorAll("#search-ui .pagefind-ui__result");
      results.forEach((result) => {
        if (result && result.querySelector(".pagefind-ui__result-link")) {
          result.style.cursor = "pointer";
        }
      });
      selectedIndex = -1;
    });

    const resultsArea = document.querySelector("#search-ui .pagefind-ui__results");
    if (resultsArea) {
      observer.observe(resultsArea, { childList: true, subtree: true });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSearch);
  } else {
    initSearch();
  }
</script>

<style>
  #search-container {
    width: 100%;
  }

  .search-fallback {
    padding: 12px;
    text-align: center;
    color: var(--color-light);
    font-size: 0.875rem;
    font-style: italic;
  }

  /* Sidebar-optimized Pagefind styles */
  #search-ui :global(.pagefind-ui) {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--color-primary);
    --pagefind-ui-text: var(--color-light);
    --pagefind-ui-background: var(--color-black);
    --pagefind-ui-border: var(--color-white-20);
    --pagefind-ui-tag: var(--color-white-8);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: var(--font-ui);
    font-family: var(--font-ui);
    width: 100%;
  }

  #search-ui :global(.pagefind-ui__form) {
    position: relative;
    margin-bottom: 0;
  }

  #search-ui :global(.pagefind-ui__search-input) {
    border: 1px solid var(--color-white-20);
    border-radius: 6px;
    padding: 8px 40px 8px 40px;
    font-size: 0.875rem;
    background: var(--color-white-8);
    width: 100%;
    font-family: var(--font-ui);
    color: var(--color-light);
    transition: all 0.2s ease;
    height: 36px;
    line-height: 1.4;
  }

  #search-ui :global(.pagefind-ui__search-input::placeholder) {
    color: #aaa;
    font-weight: 400;
  }

  #search-ui :global(.pagefind-ui__search-input:focus) {
    outline: none;
    border-color: var(--color-primary);
    background: var(--color-white-12);
    box-shadow: 0 0 0 2px rgba(13, 230, 147, 0.1);
  }

  /* Lock clear button inside the search input */
  #search-ui :global(.pagefind-ui__search-clear) {
    position: absolute;
    right: 10px;
    top: 8px;
    background: transparent;
    border: none;
    border-radius: 4px;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #888;
    font-size: 12px;
    opacity: 0.7;
    z-index: 15;
    margin: 0;
    padding: 0;
  }

  #search-ui :global(.pagefind-ui__form .pagefind-ui__search-clear) {
    position: absolute;
    right: 10px;
    top: 8px;
    background: transparent;
    border: none;
    border-radius: 4px;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #888;
    font-size: 12px;
    opacity: 0.7;
    z-index: 15;
    margin: 0;
    padding: 0;
  }

  #search-ui :global(.pagefind-ui__form .pagefind-ui__search-clear:hover) {
    background: var(--color-white-12);
    color: var(--color-light);
    opacity: 1;
    border-radius: 4px;
  }

  #search-ui :global(.pagefind-ui__results) {
    max-height: 50vh;
    overflow-y: auto;
    padding: 8px 0 0;
    scrollbar-width: thin;
    scrollbar-color: var(--color-white-20) transparent;
    margin-top: 12px;
  }

  #search-ui :global(.pagefind-ui__results::-webkit-scrollbar) {
    width: 4px;
  }

  #search-ui :global(.pagefind-ui__results::-webkit-scrollbar-track) {
    background: transparent;
  }

  #search-ui :global(.pagefind-ui__results::-webkit-scrollbar-thumb) {
    background: var(--color-white-20);
    border-radius: 2px;
  }

  #search-ui :global(.pagefind-ui__results::-webkit-scrollbar-thumb:hover) {
    background: var(--color-white-40);
  }

  #search-ui :global(.pagefind-ui__result) {
    padding: 10px 12px;
    border-radius: 6px;
    margin-bottom: 4px;
    border: 1px solid transparent;
    transition: all 0.15s ease;
    cursor: pointer;
    background: transparent;
  }

  #search-ui :global(.pagefind-ui__result:hover),
  #search-ui :global(.pagefind-ui__result.selected) {
    background: var(--color-white-8);
    border-color: var(--color-white-20);
  }

  #search-ui :global(.pagefind-ui__result.selected) {
    background: rgba(13, 230, 147, 0.1);
    border-color: var(--color-primary);
  }

  #search-ui :global(.pagefind-ui__result-link) {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  #search-ui :global(.pagefind-ui__result-title) {
    font-weight: 600;
    color: var(--color-light);
    margin: 0 0 4px 0;
    font-size: 0.9rem;
    line-height: 1.3;
    font-family: var(--font-ui);
  }

  #search-ui :global(.pagefind-ui__result-excerpt) {
    color: #999;
    font-size: 0.8rem;
    line-height: 1.4;
    margin: 0;
    font-family: var(--font-ui);
    word-wrap: break-word;
    overflow-wrap: break-word;
    max-width: 100%;
  }

  #search-ui :global(.pagefind-ui__result-excerpt mark) {
    background: rgba(13, 230, 147, 0.2);
    color: var(--color-primary);
    font-weight: 500;
    padding: 1px 2px;
    border-radius: 2px;
  }

  #search-ui :global(.pagefind-ui__result-tags) {
    margin-top: 6px;
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  #search-ui :global(.pagefind-ui__result-tag) {
    font-size: 0.7rem;
    background: rgba(13, 230, 147, 0.1);
    color: var(--color-primary);
    padding: 2px 6px;
    border-radius: 10px;
    border: 1px solid rgba(13, 230, 147, 0.2);
    font-weight: 400;
    font-family: var(--font-ui);
  }

  #search-ui :global(.pagefind-ui__message) {
    padding: 12px;
    text-align: center;
    color: #888;
    font-style: italic;
    font-family: var(--font-ui);
    font-size: 0.85rem;
  }

  #search-ui :global(.pagefind-ui__results-area:empty::before) {
    display: block;
    padding: 8px 12px;
    text-align: center;
    color: #666;
    font-style: italic;
    font-family: var(--font-ui);
    font-size: 0.75rem;
  }

  /* Override Pagefind's search icon pseudo-element */
  #search-ui :global(.pagefind-ui__form::before) {
    width: 16px !important;
    height: 16px !important;
    top: 50% !important;
    left: 10px !important;
    transform: translateY(-50%) !important;
    background-color: #888 !important;
    opacity: 0.8 !important;
    transition: opacity 0.2s ease !important;
  }

  /* Hide search icon when typing or focused */
  #search-ui :global(.pagefind-ui__form.hide-search-icon::before) {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  #search-ui :global(.pagefind-ui__form) {
    position: relative;
  }

  #search-ui :global(.pagefind-ui__result-title),
  #search-ui :global(.pagefind-ui__result-excerpt) {
    word-wrap: break-word;
    overflow-wrap: break-word;
    max-width: 100%;
  }
</style>
