---
import { getCollection } from "astro:content";
import Search from "@/components/Search.astro";

const allDocs = await getCollection("posts", ({ data }) => {
  return data.draft !== true;
});

const currentPath = Astro.url.pathname;
// Normalize path for comparison (handle trailing slashes)
const normalizePath = (path: string) => (path.endsWith("/") ? path : path + "/");

// Group docs by category and sort
const categories = new Map();
const uncategorized: {
  slug: string;
  title: string;
  href: string;
  position: number;
}[] = [];

// First pass: collect all docs by category
const docsByCategory = new Map();
allDocs.forEach((doc) => {
  const category = doc.data.category;

  if (category) {
    if (!docsByCategory.has(category)) {
      docsByCategory.set(category, []);
    }
    docsByCategory.get(category).push({
      slug: doc.slug,
      title: doc.data.title,
      href: `/posts/${doc.slug}/`,
      position: doc.data.order || 999,
      date: doc.data.date
    });
  } else {
    uncategorized.push({
      slug: doc.slug,
      title: doc.data.title,
      href: `/posts/${doc.slug}/`,
      position: doc.data.order || 999,
      date: doc.data.date
    });
  }
});

// Second pass: create categories with correct positions
docsByCategory.forEach((items, categoryName) => {
  // Find the index file for this category
  const indexItem = items.find((item) => {
    const parts = item.slug.split("/");
    return parts.length === 1;
  });

  let categoryPosition;
  if (indexItem) {
    categoryPosition = indexItem.position;
  } else if (items.length > 0) {
    // If no index file, use the position of the first item (sorted by order)
    const sortedItems = [...items].sort((a, b) => a.position - b.position);
    categoryPosition = sortedItems[0].position;
  } else {
    categoryPosition = 999;
  }

  categories.set(categoryName, {
    name: categoryName,
    position: categoryPosition,
    items: items
  });
});

// Sort categories and items within each category
const sortedCategories = Array.from(categories.values()).sort((a, b) => a.position - b.position);

sortedCategories.forEach((category) => {
  category.items.sort((a, b) => {
    // Check if either item is an index file
    const aIsIndex = !a.slug.includes("/");
    const bIsIndex = !b.slug.includes("/");

    // Index always comes first
    if (aIsIndex && !bIsIndex) return -1;
    if (!aIsIndex && bIsIndex) return 1;

    // If both or neither are index, sort by date (newest first)
    if (a.date && b.date) {
      return new Date(b.date).getTime() - new Date(a.date).getTime();
    }
    // If only one has a date, prioritize the one with date
    if (a.date && !b.date) return -1;
    if (!a.date && b.date) return 1;
    // Fall back to position if no dates
    return a.position - b.position;
  });
});

uncategorized.sort((a, b) => {
  // Sort by date (newest first)
  if (a.date && b.date) {
    return new Date(b.date).getTime() - new Date(a.date).getTime();
  }
  // If only one has a date, prioritize the one with date
  if (a.date && !b.date) return -1;
  if (!a.date && b.date) return 1;
  // Fall back to position if no dates
  return a.position - b.position;
});
---

<!-- Mobile menu button -->
<button class="mobile-menu-toggle" aria-label="Toggle navigation menu">
  <span></span>
  <span></span>
  <span></span>
</button>

<div class="sidebar-overlay" id="sidebar-overlay"></div>
<nav class="sidebar" id="sidebar">
  <div class="sidebar-content">
    <div class="sidebar-header">
      <button class="sidebar-close" aria-label="Close navigation">×</button>
    </div>
    <div class="sidebar-search">
      <Search />
    </div>
    <div class="sidebar-nav">
      {
        uncategorized.map((item) => (
          <a
            href={item.href}
            class={`nav-link ${normalizePath(currentPath) === normalizePath(item.href) ? "active" : ""}`}
          >
            {item.title}
          </a>
        ))
      }

      {
        sortedCategories.map((category) => (
          <div class="nav-category">
            {category.items.length === 1 ? (
              <a
                href={category.items[0].href}
                class={`category-header-link ${normalizePath(currentPath) === normalizePath(category.items[0].href) ? "active" : ""}`}
              >
                {category.name}
              </a>
            ) : (
              <>
                <div class="category-header">{category.name}</div>
                <div class="category-items">
                  {category.items.map((item) => (
                    <a
                      href={item.href}
                      class={`nav-link sub-link ${normalizePath(currentPath) === normalizePath(item.href) ? "active" : ""}`}
                    >
                      {item.title}
                    </a>
                  ))}
                </div>
              </>
            )}
          </div>
        ))
      }
    </div>
  </div>
</nav>

<script>
  function initMobileMenu() {
    const menuToggle = document.querySelector(".mobile-menu-toggle");
    const sidebar = document.getElementById("sidebar");
    const sidebarClose = document.querySelector(".sidebar-close");
    const sidebarOverlay = document.getElementById("sidebar-overlay");

    if (!menuToggle || !sidebar) return;

    const openSidebar = () => {
      sidebar.classList.add("mobile-open");
      menuToggle.classList.add("active", "menu-open");
      if (sidebarOverlay) sidebarOverlay.style.display = "block";
      document.body.style.overflow = "hidden";
    };

    const closeSidebar = () => {
      sidebar.classList.remove("mobile-open");
      menuToggle.classList.remove("active", "menu-open");
      if (sidebarOverlay) sidebarOverlay.style.display = "none";
      document.body.style.overflow = "";
    };

    menuToggle.addEventListener("click", () => {
      if (sidebar.classList.contains("mobile-open")) {
        closeSidebar();
      } else {
        openSidebar();
      }
    });

    sidebarClose?.addEventListener("click", closeSidebar);
    sidebarOverlay?.addEventListener("click", closeSidebar);

    // Close sidebar when clicking on navigation links
    const navLinks = sidebar.querySelectorAll(".nav-link, .category-header-link");
    navLinks.forEach((link) => {
      link.addEventListener("click", closeSidebar);
    });

    // Handle escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && sidebar.classList.contains("mobile-open")) {
        closeSidebar();
      }
    });

    // Handle menu icon color based on scroll position
    const handleMenuIconColor = () => {
      const header = document.getElementById("header");
      const headerHeight = header ? header.offsetHeight : 80;
      const scrollY = window.scrollY;

      if (scrollY > headerHeight - 40) {
        menuToggle.classList.add("on-content");
      } else {
        menuToggle.classList.remove("on-content");
      }
    };

    window.addEventListener("scroll", handleMenuIconColor);
    handleMenuIconColor(); // Initial check
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMobileMenu);
  } else {
    initMobileMenu();
  }
</script>

<style>
  .sidebar {
    width: 280px;
    background-color: var(--color-black);
    border-right: 1px solid var(--color-white-20);
    overflow-y: auto;
  }

  .sidebar-content {
    padding: 24px 0;
  }

  .sidebar-search {
    padding: 16px;
    border-bottom: 1px solid var(--color-white-20);
    margin-bottom: 16px;
  }

  .sidebar-nav {
    padding: 0 16px;
  }

  .nav-link {
    display: block;
    padding: 8px 16px;
    color: var(--color-light);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: var(--border-radius-default);
    transition: all 0.2s ease;
    margin-bottom: 4px;
  }

  .nav-link:hover {
    background-color: var(--color-white-8);
    color: var(--color-light);
  }

  .nav-link.active {
    background-color: var(--color-primary);
    color: var(--color-black);
    font-weight: 600;
  }

  .nav-category {
    margin-bottom: 16px;
  }

  .category-header {
    padding: 8px 16px;
    color: var(--color-light);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .category-header-link {
    display: block;
    padding: 8px 16px;
    color: var(--color-light);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--border-radius-default);
    transition: all 0.2s ease;
    margin-bottom: 4px;
  }

  .category-header-link:hover {
    background-color: var(--color-white-8);
    color: var(--color-light);
  }

  .category-header-link.active {
    background-color: var(--color-primary);
    color: var(--color-black);
    font-weight: 600;
  }

  .category-items {
    padding-left: 8px;
  }

  .sub-link {
    padding-left: 24px;
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .sub-link.active {
    background-color: var(--color-primary);
    color: var(--color-black);
  }

  /* Mobile menu button */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(13, 230, 147, 0.3);
    border-radius: 8px;
    cursor: pointer;
    padding: 0;
    position: fixed;
    top: 20px;
    left: 16px;
    z-index: 1001;
    transition: all 0.3s ease;
  }

  .mobile-menu-toggle:hover {
    background: rgba(0, 0, 0, 0.9);
    border-color: var(--color-primary);
    box-shadow: 0 0 12px rgba(13, 230, 147, 0.3);
  }

  .mobile-menu-toggle span {
    width: 20px;
    height: 2px;
    background-color: var(--color-primary);
    margin: 2px auto;
    transition: all 0.3s ease;
    display: block;
  }

  .mobile-menu-toggle.on-content span {
    background-color: var(--color-primary);
  }

  .mobile-menu-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-menu-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -6px);
  }

  /* Sidebar overlay */
  .sidebar-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 999;
    width: 100vw;
    height: 100vh;
  }

  /* Sidebar header (mobile only) */
  .sidebar-header {
    display: none;
    justify-content: flex-end;
    align-items: center;
    padding: 16px;
    border-bottom: 1px solid var(--color-white-20);
    margin-bottom: 0;
  }

  .sidebar-title {
    color: var(--color-light);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
  }

  .sidebar-close {
    background: none;
    border: none;
    color: var(--color-light);
    font-size: 1.5rem;
    cursor: pointer;
    padding: 4px;
    line-height: 1;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .mobile-menu-toggle {
      display: flex;
    }

    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 280px;
      transform: translateX(-100%);
      transition: transform 0.3s ease;
      z-index: 1000;
      pointer-events: auto;
    }

    .sidebar.mobile-open {
      transform: translateX(0);
    }

    .mobile-menu-toggle.menu-open {
      display: none;
    }

    .sidebar-header {
      display: flex;
    }

    .sidebar-content {
      padding-top: 0;
    }

    .sidebar-search {
      margin-top: 16px;
    }

    .nav-link,
    .category-header-link {
      color: var(--color-light);
      pointer-events: auto;
      z-index: 1001;
      position: relative;
    }

    .nav-link:hover,
    .category-header-link:hover {
      color: var(--color-light);
      background-color: var(--color-white-8);
    }

    .nav-link.active,
    .category-header-link.active {
      background-color: var(--color-primary);
      color: var(--color-black);
    }
  }
</style>
