---
import "@/app.css";
import { GoogleAnalytics } from "astro-google-analytics";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Sidebar from "@/components/Sidebar.astro";
import CodeCopyScript from "@/components/CodeCopyScript.astro";
import site from "@/content/site.json";

export interface Author {
  id: string;
  name?: string;
  title?: string;
  avatar?: string;
  bio?: string;
}

export interface Props {
  title?: string;
  description?: string;
  author?: Author;
  date?: Date;
  showSidebar?: boolean;
}

const {
  title = "Spice Labs",
  description = site.site_description,
  author,
  date,
  showSidebar = true
} = Astro.props;

// Determine if we should show sidebar based on URL
const currentPath = Astro.url.pathname;
const isDocsPage = currentPath.startsWith("/docs/");
const shouldShowSidebar = showSidebar || isDocsPage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:url" content={site.site_url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content={description}
      <meta
      property="og:image"
      content={site.site_url + "/images/preview.png"}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={site.site_domain} />
    <meta property="twitter:url" content={site.site_url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site.site_url + "/images/preview.png"} />

    <GoogleAnalytics id="G-EVMYQSR30G" />
  </head>
  <body>
    <div id="container" class={shouldShowSidebar ? "with-sidebar" : ""}>
      <Header />
      <div class="layout-wrapper">
        {shouldShowSidebar && <Sidebar />}
        <main class={shouldShowSidebar ? "docs-main" : ""}>
          {
            shouldShowSidebar ? (
              <>
                <header class="blog-header">
                  <div class="blog-header-content">
                    {title && <h1 class="blog-title">{title}</h1>}
                    {description && <p class="blog-description">{description}</p>}
                    {(author || date) && (
                      <div class="blog-meta">
                        {author && author.avatar && (
                          <img
                            src={author.avatar}
                            alt={author.name || author.id}
                            class="author-avatar"
                          />
                        )}
                        <div class="author-info">
                          <div class="author-name-date">
                            {author && <span class="author-name">{author.name || author.id}</span>}
                            {author && date && <span class="blog-meta-separator">•</span>}
                            {date && (
                              <time class="blog-date" datetime={date.toISOString()}>
                                {date.toLocaleDateString("en-US", {
                                  month: "long",
                                  day: "numeric",
                                  year: "numeric"
                                })}
                              </time>
                            )}
                          </div>
                          {author && author.title && <div class="author-title">{author.title}</div>}
                        </div>
                      </div>
                    )}
                  </div>
                </header>
                <div class="docs-content">
                  <slot />
                </div>
              </>
            ) : (
              <slot />
            )
          }
        </main>
      </div>
      <Footer />
    </div>
    <CodeCopyScript />
  </body>
</html>

<style is:global>
  body {
    background-color: var(--color-black);
    margin: 0;
    padding: 0;
  }

  #container {
    min-width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  #container:not(.with-sidebar) {
    max-width: 1440px;
    margin: 0 auto;
  }

  main {
    margin: 0;
    padding: 0;
    flex: 1;
  }

  main:not(.docs-main) {
    background: var(--color-light);
  }

  /* Blog header styles */
  .blog-header {
    background-color: var(--color-black);
    background-image: url("/images/HeroBackground.svg");
    background-size: 120% auto;
    background-position: center;
    background-repeat: no-repeat;
    border-bottom: 1px solid rgba(13, 230, 147, 0.2);
    padding: 80px 48px 60px;
    margin-bottom: 0;
  }

  .blog-header-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .blog-title {
    color: var(--color-light);
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 24px 0;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-black) 130%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .blog-description {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.25rem;
    line-height: 1.6;
    margin: 0 0 32px 0;
    font-weight: 400;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-ui);
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-primary);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .author-name-date {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1rem;
  }

  .author-name {
    color: var(--color-light);
    font-weight: 600;
  }

  .author-title {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
    font-weight: 400;
  }

  .blog-meta-separator {
    color: rgba(255, 255, 255, 0.3);
  }

  .blog-date {
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
  }

  /* Docs-specific styles */
  .layout-wrapper {
    display: flex;
    min-height: calc(100vh - var(--header-height));
    width: 100%;
  }

  .docs-main {
    flex: 1;
    background: var(--color-light);
    min-width: 0;
  }

  .docs-content {
    max-width: none;
    width: 100%;
    padding: 48px 48px;
    color: var(--color-black);
    font-family: var(--font-ui);
    line-height: 1.7;
  }

  .docs-content h1 {
    color: var(--color-black);
    font-size: 3rem;
    font-weight: 800;
    margin-bottom: 24px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, var(--color-black) 0%, #333 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .docs-content h2 {
    color: var(--color-black);
    font-size: 2rem;
    font-weight: 700;
    margin-top: 48px;
    margin-bottom: 20px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-white-20);
  }

  .docs-content h3 {
    color: var(--color-black);
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 36px;
    margin-bottom: 16px;
    line-height: 1.3;
  }

  .docs-content h4 {
    color: var(--color-black);
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 28px;
    margin-bottom: 12px;
    line-height: 1.4;
  }

  .docs-content p,
  .docs-content p:first-of-type,
  .docs-content p:last-of-type {
    line-height: 1.7;
    margin-bottom: 20px;
    font-size: 1.0625rem;
    max-width: none;
    width: 100%;
  }

  .docs-content p:first-of-type {
    font-size: 1.125rem;
    color: #555;
    margin-bottom: 32px;
  }

  .docs-content ul,
  .docs-content ol {
    margin-bottom: 20px;
    padding-left: 28px;
  }

  .docs-content li {
    line-height: 1.8;
    margin-bottom: 24px;
    font-size: 1.0625rem;
  }

  .docs-content li::marker {
    color: var(--color-primary);
    font-weight: 600;
  }

  .docs-content li strong:first-child {
    color: var(--color-black);
    font-weight: 700;
    font-size: 1.125rem;
    display: block;
    margin-bottom: 6px;
  }

  .docs-content strong {
    font-weight: 600;
    color: var(--color-black);
  }

  .docs-content code {
    background-color: rgba(13, 230, 147, 0.1);
    color: var(--color-black);
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 0.9em;
    font-weight: 500;
    border: 1px solid rgba(13, 230, 147, 0.2);
  }

  .docs-content pre code {
    background-color: transparent;
    padding: 0;
    border: none;
    color: var(--color-light);
    font-weight: normal;
  }

  .docs-content a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .docs-content a:hover {
    border-bottom-color: var(--color-primary);
    background: linear-gradient(135deg, rgba(13, 230, 147, 0.1) 0%, rgba(13, 230, 147, 0.05) 100%);
    padding: 2px 4px;
    margin: -2px -4px;
    border-radius: 4px;
  }

  .docs-content blockquote {
    border-left: 4px solid var(--color-primary);
    background: rgba(13, 230, 147, 0.05);
    padding: 20px 24px;
    margin: 24px 0;
    border-radius: 0 8px 8px 0;
    font-style: italic;
  }

  .docs-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 1rem;
  }

  .docs-content th,
  .docs-content td {
    border: 1px solid var(--color-white-40);
    padding: 12px 16px;
    text-align: left;
  }

  .docs-content th {
    background-color: var(--color-white-8);
    font-weight: 600;
    color: var(--color-black);
  }

  .docs-content hr {
    border: none;
    height: 2px;
    background: linear-gradient(90deg, var(--color-primary) 0%, transparent 100%);
    margin: 48px 0;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    #container {
      min-width: 0;
    }

    .blog-header {
      padding: 48px 24px 40px;
    }

    .blog-title {
      font-size: 2rem;
      margin-bottom: 16px;
      word-wrap: break-word;
    }

    .blog-description {
      font-size: 1rem;
      margin-bottom: 24px;
      word-wrap: break-word;
    }

    .blog-meta {
      font-size: 0.875rem;
      gap: 12px;
      flex-wrap: wrap;
    }

    .author-avatar {
      width: 40px;
      height: 40px;
    }

    .author-name {
      font-size: 0.9375rem;
    }

    .author-title {
      font-size: 0.8125rem;
    }

    #container.with-sidebar {
      min-height: 100vh;
    }

    .layout-wrapper {
      flex-direction: column;
      min-height: calc(100vh - 64px);
    }

    .docs-main {
      width: 100%;
      min-height: calc(100vh - 64px - 60px);
    }

    .docs-content {
      padding: 24px 16px 48px;
      min-height: calc(100vh - 64px - 60px - 48px);
    }

    .docs-content h1 {
      font-size: 1.5rem;
      margin-bottom: 16px;
      line-height: 1.1;
    }

    .docs-content h2 {
      font-size: 1.5rem;
      margin-top: 32px;
      margin-bottom: 16px;
    }

    .docs-content h3 {
      font-size: 1.25rem;
      margin-top: 24px;
      margin-bottom: 12px;
    }

    .docs-content h4 {
      font-size: 1.125rem;
      margin-top: 20px;
      margin-bottom: 10px;
    }

    .docs-content p,
    .docs-content p:first-of-type,
    .docs-content p:last-of-type {
      font-size: 0.9375rem;
      line-height: 1.6;
    }

    .docs-content p:first-of-type {
      margin-bottom: 24px;
    }

    .docs-content li {
      font-size: 0.9375rem;
      line-height: 1.7;
      margin-bottom: 18px;
    }

    .docs-content li strong:first-child {
      font-size: 1rem;
      margin-bottom: 4px;
    }

    .docs-content ul,
    .docs-content ol {
      padding-left: 20px;
    }
  }
</style>
