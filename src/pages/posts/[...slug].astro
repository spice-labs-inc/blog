---
import { getCollection, getEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => data.draft !== true);
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Fetch author data if author is specified
let authorData = undefined;
if (entry.data.author) {
  try {
    const authorEntry = await getEntry("authors", entry.data.author);
    if (authorEntry) {
      authorData = authorEntry.data;
    }
  } catch (e) {
    // If author not found, fall back to just using the author string as name
    authorData = { id: entry.data.author, name: entry.data.author };
  }
}
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  author={authorData}
  date={entry.data.date}
>
  <Content />
</Layout>
